# Where your harnesses keep their sessions, per OS. Copy to `.env` and uncomment your
# platform. macOS needs none of this — the compose defaults already point at these paths.
#
# Docker Desktop accepts forward slashes on Windows, which avoids escaping backslashes here.
# Every one of these is mounted read-only.

# --- Windows ---
# BC_CLAUDE_DIR=C:/Users/YOU/.claude
# BC_CLAUDE_DESKTOP_DIR=C:/Users/YOU/AppData/Roaming/Claude
# BC_CODEX_DIR=C:/Users/YOU/.codex
# BC_CURSOR_PROJECTS_DIR=C:/Users/YOU/.cursor/projects

# --- Linux ---
# BC_CLAUDE_DIR=/home/you/.claude
# BC_CLAUDE_DESKTOP_DIR=/home/you/.config/Claude
# BC_CODEX_DIR=/home/you/.codex
# BC_CURSOR_PROJECTS_DIR=/home/you/.cursor/projects

# A harness you do not use can point anywhere that exists — the adapter simply finds
# nothing and that harness stays out of the colony.
